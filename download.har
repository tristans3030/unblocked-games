            "size": 3748,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Flappy 2048 | 3kh0</title>\n\n  <link href=\"style/main.css\" rel=\"stylesheet\" type=\"text/css\">\n  <link rel=\"shortcut icon\" href=\"favicon.ico\">\n  <link rel=\"apple-touch-icon\" href=\"meta/apple-touch-icon.png\">\n  <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n\n  <meta name=\"HandheldFriendly\" content=\"True\">\n  <meta name=\"MobileOptimized\" content=\"320\">\n  <script src=\"/js/main.js\"></script>\n  <meta name=\"viewport\" content=\"width=device-width, target-densitydpi=160dpi, initial-scale=1.0, maximum-scale=1, user-scalable=no, minimal-ui\">\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"heading\">\n      <h1 class=\"title\">Flappy 2048</h1>\n      <div class=\"scores-container\">\n        <div class=\"score-container\">0</div>\n        <div class=\"best-container\">0</div>\n      </div>\n    </div>\n    <p class=\"game-intro\">Jump through the tiles and get to <strong>2048!</strong></p>\n\n    <div class=\"game-container\">\n      <div class=\"game-message\">\n        <p></p>\n        <div class=\"lower\">\n\t        <a class=\"keep-playing-button\">Keep going</a>\n          <a class=\"retry-button\">Try again</a>\n        </div>\n      </div>\n\n      <div class=\"grid-container\">\n        <div class=\"grid-row\">\n          <div class=\"grid-cell\"></div>\n          <div class=\"grid-cell\"></div>\n          <div class=\"grid-cell\"></div>\n          <div class=\"grid-cell\"></div>\n        </div>\n        <div class=\"grid-row\">\n          <div class=\"grid-cell\"></div>\n          <div class=\"grid-cell\"></div>\n          <div class=\"grid-cell\"></div>\n          <div class=\"grid-cell\"></div>\n        </div>\n        <div class=\"grid-row\">\n          <div class=\"grid-cell\"></div>\n          <div class=\"grid-cell\"></div>\n          <div class=\"grid-cell\"></div>\n          <div class=\"grid-cell\"></div>\n        </div>\n        <div class=\"grid-row\">\n          <div class=\"grid-cell\"></div>\n          <div class=\"grid-cell\"></div>\n          <div class=\"grid-cell\"></div>\n          <div class=\"grid-cell\"></div>\n        </div>\n        <div class=\"tile tile-block-a\"><div class=\"tile-inner\"></div></div>\n        <div class=\"tile tile-block-b\"><div class=\"tile-inner\"></div></div>\n        <div class=\"tile tile-block-c\"><div class=\"tile-inner\"></div></div>\n        <div class=\"tile tile-block-d\"><div class=\"tile-inner\"></div></div>\n        <div class=\"tile tile-bird\"><div class=\"tile-inner\"></div></div>\n      </div>\n    </div>\n     <hr>\n    <p class=\"game-explanation\">\n      <strong class=\"important\">How to play:</strong> Press <strong>any key</strong> to move the tile. When the tile goes through a barrier, you get a <strong>point!</strong>\n    </p>\n    <p>Made by <a href=\"/\">Echo</a>.</p>\n  <script src=\"js/animframe_polyfill.js\"></script>\n  <script src=\"js/keyboard_input_manager.js\"></script>\n  <script src=\"js/html_actuator.js\"></script>\n  <script src=\"js/grid.js\"></script>\n  <script src=\"js/tile.js\"></script>\n  <script src=\"js/local_score_manager.js\"></script>\n  <script src=\"js/game_manager.js\"></script>\n  <script src=\"js/application.js\"></script>\n<script>window.__CF$cv$params={r:'a5cc924dbc2fe66c',t:'MTc5NTA2MzU5MA==',u:'01a1ed091444728ab851ac8ffe15db9f',ut:'g.dQ4iC9VNU4WAdvND6cELUhgrBRsSwxu0z1T5K1._Y-1795063590-1.2.1.1-uJJx4bKs_zQpCep3pv73Gb4P4vCH1Z0yxvhNbVR2eyZrrxIU.4A9uKUIfSPvu88r39BL2eaJqkHPBe2zSVqM1Mndn5g.1zbyuoF3RcECi8E',i:60};(function(){if(!document.body)return;var l=window.location,o;try{o=new URL(l.origin).origin}catch(e){try{o=new URL(new URL(l.href).origin).origin}catch(e){o=''}}var u='/cdn-cgi/challenge-platform/scripts/precursor/main.js?ray=a5cc924dbc2fe66c',s=document.createElement('script');s.src=o?new URL(u,o).href:u;document.head.appendChild(s);})();</script></body>\n</html>\n"
